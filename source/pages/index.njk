{# {% extends "default.njk" %} #}
{% extends template %}

{% set pageTitle = "Купить Ананасовый улун в Москве по доступной цене — интернет-магазин «Чайный Бум»" %}

{% block main %}

  <section class="product">

    <h1 class="product__title">Ананасовый улун</h1>

    <div class="product__image-block">
      <a class="product__image-link" href="https://media.teaboom.ru/images/e4bb1618-fb80-41e2-8758-86f884ce095d.jpg" data-fancybox="product">
        <picture>
          <img class="product__image" src="https://media.teaboom.ru/images/e4bb1618-fb80-41e2-8758-86f884ce095d.jpg" alt="Ананасовый улун">
        </picture>
      </a>

    </div>

    <div class="product__params">

      <a class="product__leave-feedback" href="#">Оставить отзыв</a>

      <button class="product__favorite btn btn--favorite" type="button">
        <span class="visually-hidden">Добавить в избранное</span>
      </button>

      <div class="product__configuration">
        <div class="product__variants">
          <button class="product__variant product__variant--active btn" type="button" data-sku="01306" data-price-old="349,20" data-price-new="326,40" data-stock="Много">
            100&nbsp;г
          </button>
          <button class="product__variant btn" type="button" data-sku="01307" data-price-old="1646,00" data-price-new="1432,00" data-stock="Много">
            500&nbsp;г
          </button>
          <button class="product__variant btn" type="button" data-sku="01308" data-price-old="2592,00" data-price-new="2064,00" data-stock="Мало">
            1000&nbsp;г
          </button>
          <button class="product__variant btn" type="button" data-sku="01309" data-price-old="8710,00" data-price-new="6320,00" data-stock="Много">
            5000&nbsp;г
          </button>
        </div>

        <p class="product__sku">
          <span class="product__sku-label">Артикул:</span>
          <span class="product__sku-value" data-product-sku>01306</span>
        </p>

        <div class="product__stock">
          <span class="product__stock-label">Наличие:</span>
          <span class="product__stock-value" data-product-stock>Много</span>
        </div>

        <p class="product__price">
          <s class="product__price-old" data-product-price-old>349,20 ₽</s>
          <b class="product__price-new" data-product-price-new>326,40 ₽</b>
        </p>


        <div class="product__composition">
          <p><b>Состав</b>: китайский бирюзовый чай, цукаты, натуральные ароматические масла. </p>
          <p><a href="#description">К полному описанию</a></p>
        </div>

        <button class="product__to-cart btn btn--to-cart" type="button">
          <span class="product__to-cart-text">В корзину</span>
          <span class="product__badge" data-product-count hidden>0</span>
        </button>
      </div>
    </div>

    <div class="product__description" id="description">
      <h2>Описание</h2>

      <p>Светлый Фуцзяньский улун с&nbsp;ароматом
        ананаса. В&nbsp;сухом виде&nbsp;&mdash; красивый крупный лист изумрудного цвета, скруткой листа напоминающий Те&nbsp;Гуань
        Инь.
        В&nbsp;прогретой посуде аромат свежей, весенней зелени и&nbsp;спелого ананаса. Скрученный лист медленно
        раскрывается,
        отдавая весь свой аромат. Тем, кому пришёлся по&nbsp;вкусу этот чай, может также
        понравиться <a href="/product/svyazannij-chaj-ananasovyj-raj-100">связанный чай &laquo;Ананасовый
          рай&raquo;.</a></p>
      <h3>Вкус</h3>
      <p>Настой прозрачный, светло-янтарного цвета. Классическая нота светлого фуцзяньского улуна переплетается c
        яркой ананасовой нотой.</p>
      <h3>Полезные свойства</h3>
      <ul>
        <li>отличный антиоксидант</li>
        <li>снижает уровень холестерина</li>
        <li>снижает лишний вес</li>
      </ul>
    </div>

  </section>





{% endblock %}
